class Solution {
  public:
  
  
  void merge(int s,int e,vector<int> &arr,int &count)
  {
         
         int mid=(s+e)/2;
         
         vector<int> v1,v2,v3;
         
         
         for(int i=s;i<=mid;i++)
         {
            v1.push_back(arr[i]);   
         }
         
         
         for(int i=mid+1;i<=e;i++)
         {
             v2.push_back(arr[i]);
         }
         
         int i=0,j=0;
         
         while(i<v1.size() && j<v2.size())
         {
             if(v1[i]>v2[j])
             {
                 v3.push_back(v2[j]);
                 j++;
                 count++;
             }
             else if(v1[i]<v2[j])
             {
                 v3.push_back(v1[i]);
                 i++;
             }
             else
             {
                 v3.push_back(v1[i]);
                 v3.push_back(v1[i]);
                 
                 i++;
                 j++;
             }
             
         }
         
         //s e
         
         if(i==v1.size())
         {
             for(int k=j;k<v2.size();k++)
             {
                 v3.push_back(v2[k]);
             }
         }
         
         if(j==v2.size())
         {
             for(int k=i;k<v1.size();k++)
             {
                 v3.push_back(v1[k]);
             }
         }
         
         for(int k=s;k<=e;k++)
         {
             arr[k]=v3[k-s];
         }
         
  }
         
  
  
  
  
  void break_arr(int s,int e,vector<int>& arr,int &count){
      
        if(s==e)
        {
            return;
        }
      
         int mid=(s+e)/2;
         
         break_arr(s,mid,arr,count);
         
         break_arr(mid+1,e,arr,count);
      
      merge(s,e,arr,count);
  }
  
    int minSwaps(vector<int>& arr) {
        // Code here
        
        
        int count=0;
        
        break_arr(0,arr.size()-1,arr,count);
        
        return count;
        
    }
};
